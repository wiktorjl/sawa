# Polygon.io API credentials (required)
POLYGON_API_KEY=your_api_key
POLYGON_S3_ACCESS_KEY=your_s3_access_key_here
POLYGON_S3_SECRET_KEY=your_s3_secret_key_here

# FRED API key (required for market internals: VIX, VIX3M, HY spread).
# Free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key

# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/postgres

# Alternative PostgreSQL config (used if DATABASE_URL not set)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=stock_data
# PGUSER=postgres
# PGPASSWORD=your_password_here

# Optional: push notifications for scheduler / pipeline alerts
# NTFY_TOPIC=https://ntfy.sh/your-topic

# Timestamped run-log retention in days; 0 disables automatic pruning.
# SAWA_LOG_RETENTION_DAYS=90

# Optional: dead-man's-switch heartbeats (healthchecks.io-style ping URLs).
# The scheduler pings the first two after a successful daily/weekly (and the
# /fail variant on failure), the third on every 15-minute tick, and
# `sawa doctor --job watchdog` pings the fourth. The monitor alerts on the
# ABSENCE of a ping, which is the only signal that survives a scheduler that
# never starts a job. See docs/OPERATIONS.md "Monitoring".
# SAWA_HEARTBEAT_URL=https://hc-ping.com/<daily-uuid>
# SAWA_WEEKLY_HEARTBEAT_URL=https://hc-ping.com/<weekly-uuid>
# SAWA_TICK_HEARTBEAT_URL=https://hc-ping.com/<per-tick-uuid>
# SAWA_WATCHDOG_HEARTBEAT_URL=https://hc-ping.com/<watchdog-uuid>

# NOTE: scripts/market_scheduler.sh exports ONLY the keys in its allowlist
# (setup_env) to the jobs it runs. Any other key in this file is ignored with a
# WARN line on every tick and ONE warning push; process-control names (PATH,
# PYTHONPATH, LD_PRELOAD, ...) abort the tick with an error push.
# tests/test_scheduler_security.py asserts every key documented here is
# allowlisted. MCP server settings (MCP_LOG_LEVEL, MCP_MAX_ROWS, ...) belong in
# the MCP client's `env` configuration, not here (docs/MAINTENANCE.md §5).
